# Optional cloud accounts. Without any of these, Nocturne keeps data in the browser.

# Firebase (preferred when set): Project settings → General → Your apps → Web app config
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_APP_ID=

# Or Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Claude connector (MCP server, deployed from this repo to Vercel; see mcp/README.md)
NEXT_PUBLIC_MCP_URL=
